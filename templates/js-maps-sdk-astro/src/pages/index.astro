---
const title = "ArcGIS Maps SDK for JavaScript Astro template";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="data:;base64,=" />
    <style>
      html,
      body {
        background-color: var(--calcite-color-background);
        height: 100%;
        margin: 0;
      }

      :root {
        --calcite-color-brand: #b34b00;
        --calcite-color-brand-hover: #9f4504;
        --calcite-color-brand-press: #803703;
        --calcite-color-focus: #b34b00;
        --calcite-color-background: #faf3e3;
        --calcite-color-foreground-1: #fffaed;
        --calcite-color-foreground-2: #fae9c8;
        --calcite-color-foreground-3: #fce5b6;
        --calcite-color-foreground-current: #ebd09d;
      }

      calcite-navigation-logo {
        --calcite-navigation-logo-heading-text-color: var(--calcite-color-brand);
      }

      arcgis-chart {
        width: min(clamp(360px, 40dvw, 640px), calc(100dvw - 80px));
        height: clamp(250px, 40dvh, 400px);
      }
    </style>
  </head>
  <body>
    <!-- The Shell component is used as a layout for this template -->
    <calcite-shell content-behind>
      <calcite-navigation slot="header">
        <calcite-navigation-logo heading-level="1" slot="logo"></calcite-navigation-logo>
      </calcite-navigation>

      <!-- The Map component fits to the size of the parent element -->
      <!-- The basemap, extent, zoom and more are provided by the Web Map (item-id) -->
      <arcgis-map item-id="dd4b2f25487d4a37a45093ba6acd026d" popup-component-enabled>
        <arcgis-zoom slot="top-left"></arcgis-zoom>
        <arcgis-search slot="top-right"></arcgis-search>
        <arcgis-expand slot="bottom-left">
          <arcgis-legend></arcgis-legend>
        </arcgis-expand>
        <arcgis-chart layer-item-id="b1717962dab247ad93eaca257b32fe02" chart-index="0" slot="bottom-right"
        ></arcgis-chart>
      </arcgis-map>
    </calcite-shell>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
