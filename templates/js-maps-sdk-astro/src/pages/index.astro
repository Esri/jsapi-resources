---
const title = "ArcGIS Maps SDK for JavaScript Astro template";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="data:;base64,=" />
    <style>
      html,
      body {
        background-color: var(--calcite-color-background);
        height: 100%;
        margin: 0;
      }

      :root {
        /* Remove these CSS variables to revert back to Calcite defaults. */
        --calcite-color-brand: light-dark(#b34b00, #e6a14c);
        --calcite-color-brand-hover: light-dark(#9f4504, #f5b765);
        --calcite-color-brand-press: light-dark(#803703, #ffd08b);
        --calcite-color-focus: light-dark(#b34b00, #e6a14c);
        --calcite-color-background: light-dark(#faf3e3, #211a12);
        --calcite-color-foreground-1: light-dark(#fffaed, #2d2418);
        --calcite-color-foreground-2: light-dark(#fae9c8, #3b2d1f);
        --calcite-color-foreground-3: light-dark(#fce5b6, #4a3722);
        --calcite-color-foreground-current: light-dark(#ebd09d, #6f4518);
        --calcite-color-text-1: light-dark(#141414, #f6ebd0);
        --calcite-color-text-2: light-dark(#4a4a4a, #e7d4a9);
        --calcite-color-text-3: light-dark(#555555, #d8c398);
        /* Keep `color-scheme: light dark` to prevent Lightning CSS from creating invalid Calcite light-dark() colors.
           https://github.com/Esri/calcite-design-system/blob/dev/examples/components/vite/README.md#avoid-the-vitelightning-css-light-dark-issue */
        color-scheme: light dark;
      }

      calcite-navigation-logo {
        --calcite-navigation-logo-heading-text-color: var(--calcite-color-brand);
      }

      arcgis-chart {
        width: min(clamp(360px, 40dvw, 640px), calc(100dvw - 80px));
        height: clamp(250px, 40dvh, 400px);
      }
    </style>
  </head>
  <body class="calcite-mode-auto">
    <!-- The Shell component is used as a layout for this template -->
    <calcite-shell content-behind>
      <calcite-navigation slot="header">
        <calcite-navigation-logo heading-level="1" slot="logo"></calcite-navigation-logo>
      </calcite-navigation>

      <!-- The Map component fits to the size of the parent element -->
      <!-- The basemap, extent, zoom and more are provided by the Web Map (item-id) -->
      <arcgis-map item-id="dd4b2f25487d4a37a45093ba6acd026d" popup-component-enabled>
        <arcgis-zoom slot="top-left"></arcgis-zoom>
        <arcgis-search slot="top-right"></arcgis-search>
        <arcgis-expand slot="bottom-left">
          <arcgis-legend></arcgis-legend>
        </arcgis-expand>
        <arcgis-chart layer-item-id="b1717962dab247ad93eaca257b32fe02" chart-index="0" slot="bottom-right"
        ></arcgis-chart>
      </arcgis-map>
    </calcite-shell>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
